# ==============================================================================
# LuxScale 2.0 Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string for user profiles, accounts, and project metadata.
# In development, defaults to sqlite:///./luxscale_v2.db if unset.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luxscale

# ------------------------------------------------------------------------------
# 2. Authentication & Single Sign-On (SSO) with sc-idp (Phase 2)
# ------------------------------------------------------------------------------
# Canonical base URL of the Identity Provider (sc-idp)
IDP_ISSUER_URL=http://localhost:8000

# OAuth2 / OIDC credentials registered in sc-idp
IDP_CLIENT_ID=lxscale
IDP_CLIENT_SECRET=lxscale-secret
IDP_REDIRECT_URI=http://localhost:8001/api/v2/auth/callback

# Master HMAC-SHA256 secret key for signing LuxScale product access JWTs.
# Must be at least 32 characters long in production.
AUTH_SECRET_KEY=change-this-to-a-very-secure-32-byte-secret-key-1234567890

# Token Lifetimes
# ACCESS_TOKEN_EXPIRE_MINUTES: Lifetime of minted access JWTs in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS: Sliding lifetime of the refresh token cookie in days (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cross-Subdomain SSO & Cookie Security
# COOKIE_DOMAIN: Set to parent domain (e.g. .lxscale.com) to share session across
# app.lxscale.com and lxscale.com. Leave empty or unset for localhost.
COOKIE_DOMAIN=
# COOKIE_SECURE: Set to true in production so cookies are only transmitted over HTTPS.
COOKIE_SECURE=false

# Allowed Frontend Origins for CORS and cookie credentials (comma-separated list of URLs)
ALLOWED_FRONTEND_ORIGINS=http://localhost:4200,http://localhost:4201,https://app.lxscale.com,https://lxscale.com

# ------------------------------------------------------------------------------
# 3. Object Storage Configuration (Phase 1)
# ------------------------------------------------------------------------------
# Storage Provider: "local" (disk with HMAC signed URLs) or "s3" (AWS S3 / Cloudflare R2)
STORAGE_BACKEND=local

# Local Storage Provider Settings (used when STORAGE_BACKEND=local)
# STORAGE_LOCAL_DIR: Filesystem directory path for storing .lxsc archives and thumbnails
STORAGE_LOCAL_DIR=~/.luxscale/storage
# STORAGE_BASE_URL: Base URL used to generate signed streaming URLs for the browser
STORAGE_BASE_URL=http://localhost:8001
# STORAGE_LOCAL_SECRET: HMAC key used to sign temporary upload tickets and download tokens
STORAGE_LOCAL_SECRET=change-this-local-storage-secret-key

# S3 / Cloudflare R2 Provider Settings (used when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=luxscale
# S3_ENDPOINT_URL: Custom endpoint (required for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION_NAME: "auto" for Cloudflare R2, or AWS region (e.g. "us-east-1")
S3_REGION_NAME=auto
# S3_PUBLIC_DOMAIN: Optional custom CDN or public bucket domain (e.g. https://cdn.lxscale.com)
S3_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 4. External Admin & Catalog Services
# ------------------------------------------------------------------------------
# Base URL for Standards service (e.g. EN 12464-1 compliance profiles)
STANDARDS_BASE_URL=
# Base URL for Fixtures/Catalog service (luminaire variants & .ies / .ldt files)
FIXTURES_BASE_URL=
