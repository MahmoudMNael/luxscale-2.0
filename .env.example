# Admin backend base URLs (with or without the /api/v1 suffix — both work).
# Standards DTOs: app/schemas/standards.py | Fixture/variant/asset DTOs: app/schemas/fixtures.py
# Target: GET {STANDARDS_BASE_URL}/api/v1/standards/{activityId}
STANDARDS_BASE_URL=
# Variants: GET {FIXTURES_BASE_URL}/api/v1/fixtures/variants/?application=&is_main_solution=true
# IES bytes: GET {FIXTURES_BASE_URL}/api/v1/assets/{ies_file_id}
FIXTURES_BASE_URL=
